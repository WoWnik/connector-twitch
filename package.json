{
  "name": "@wownikcompany/connector-twitch",
  "version": "1.0.1",
  "description": "Custom Twitch connector implementation for Logto",
  "author": "wownik <wownik98@gmail.com>",
  "license": "MIT License",
  "type": "module",
  "files": [
    "lib",
    "docs",
    "logo.svg"
  ],
  "scripts": {
    "precommit": "lint-staged",
    "check": "tsc --noEmit",
    "build": "tsup src/index.ts",
    "dev": "tsup --watch",
    "lint": "eslint --ext .ts src",
    "lint:report": "npm run lint --format json --output-file report.json",
    "test": "vitest run src",
    "test:watch": "vitest src --watch",
    "test:ci": "npm run test --silent --coverage",
    "prepublishOnly": "npm run build"
  },
  "eslintConfig": {
    "extends": "@silverhand",
    "settings": {
      "import/core-modules": [
        "@silverhand/essentials",
        "got",
        "nock",
        "snakecase-keys",
        "zod"
      ]
    }
  },
  "prettier": "@silverhand/eslint-config/.prettierrc",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@logto/connector-kit": "^5.1.1",
    "@silverhand/essentials": "^2.9.1",
    "got": "^14.0.0",
    "snakecase-keys": "^8.0.1",
    "zod": "3.24.3"
  },
  "devDependencies": {
    "@silverhand/eslint-config": "6.0.1",
    "@silverhand/ts-config": "6.0.0",
    "@types/node": "^22.14.0",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^8.56.0",
    "lint-staged": "^15.0.2",
    "nock": "^14.0.3",
    "prettier": "^3.5.3",
    "supertest": "^7.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.5.3",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@12.3.4+sha512.961aa41fb077da3a04a441d9f8e15ebc0c96da8ef710b2eb67bf9ee7cb0610eabd48f1fd85f51cffe73846785fa0f87c56a3a872a1d893f8446741b5cce45457"
}
